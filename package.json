{
  "name": "mania-image",
  "type": "module",
  "version": "0.1.1",
  "description": "A TypeScript library for rendering osu!mania beatmaps to PNG images with Canvas 2D API.",
  "author": "zzzzv",
  "license": "MIT",
  "homepage": "https://github.com/zzzzv/mania-image",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zzzzv/mania-image.git"
  },
  "bugs": {
    "url": "https://github.com/zzzzv/mania-image/issues"
  },
  "keywords": [
    "osu",
    "mania",
    "beatmap"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.3",
    "@types/node": "^25.6.2",
    "@typescript/native-preview": "7.0.0-dev.20260509.2",
    "osu-mania-io": "^0.1.0",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "canvas"
    ]
  }
}
